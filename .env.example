# Template for .env, which holds the Firebase web config:
# Firebase console > Project settings > Your apps > Web app > firebaseConfig.
# These values are public (they ship in the site's JavaScript), so .env is
# committed. Access is controlled by sign-in and firestore.rules.
# Never put real secrets, such as service account keys, in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
