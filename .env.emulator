# Used by `npm run dev:emulator` (Vite mode "emulator"); overrides .env.
# Points the app at the local Firebase emulators (`npm run emulators`).
# A project id starting with "demo-" can never reach a real Firebase project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-gursch
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_USE_EMULATORS=true
